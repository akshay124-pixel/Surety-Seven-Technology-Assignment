generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApplicationStatus {
  PENDING
  EVALUATING
  APPROVED
  REFERRED
  DECLINED
  FAILED
}

enum BondType {
  CONTRACT
  COMMERCIAL
  COURT
  FIDELITY
  LICENSE_PERMIT
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
}

model Application {
  id            String            @id @default(uuid())
  applicationId String            @unique @map("application_id")
  applicantId   String            @map("applicant_id")
  bondType      BondType          @map("bond_type")
  bondAmount    Decimal           @map("bond_amount") @db.Decimal(15, 2)
  effectiveDate DateTime          @map("effective_date") @db.Date
  obligeeName   String            @map("obligee_name")
  status        ApplicationStatus @default(PENDING)
  score         Int?
  decision      String?
  failureCode   String?           @map("failure_code")
  failureMessage String?          @map("failure_message")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  applicantSnapshot ApplicantSnapshot?
  decisionFactors   DecisionFactor[]
  outboxEvents      OutboxEvent[]

  @@index([applicantId])
  @@index([status])
  @@index([createdAt])
  @@map("applications")
}

model ApplicantSnapshot {
  id               String      @id @default(uuid())
  applicationId    String      @unique @map("application_id")
  applicantId      String      @map("applicant_id")
  annualRevenue    Decimal     @map("annual_revenue") @db.Decimal(15, 2)
  yearsInBusiness  Int         @map("years_in_business")
  creditScore      Int         @map("credit_score")
  existingExposure Decimal     @map("existing_exposure") @db.Decimal(15, 2)
  retrievedAt      DateTime    @default(now()) @map("retrieved_at")
  
  application      Application @relation(fields: [applicationId], references: [applicationId], onDelete: Cascade)

  @@index([applicantId])
  @@map("applicant_snapshots")
}

model DecisionFactor {
  id            String      @id @default(uuid())
  applicationId String      @map("application_id")
  factor        String
  inputValue    String      @map("input_value")
  rule          String
  points        Int
  explanation   String
  createdAt     DateTime    @default(now()) @map("created_at")

  application   Application @relation(fields: [applicationId], references: [applicationId], onDelete: Cascade)

  @@index([applicationId])
  @@map("decision_factors")
}

model OutboxEvent {
  id            String             @id @default(uuid())
  eventId       String             @unique @map("event_id")
  eventType     String             @map("event_type")
  applicationId String             @map("application_id")
  payload       Json
  status        OutboxEventStatus  @default(PENDING)
  attempts      Int                @default(0)
  availableAt   DateTime           @default(now()) @map("available_at")
  lastError     String?            @map("last_error")
  createdAt     DateTime           @default(now()) @map("created_at")
  deliveredAt   DateTime?          @map("delivered_at")

  application   Application        @relation(fields: [applicationId], references: [applicationId], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([applicationId])
  @@map("outbox_events")
}

model IdempotencyRecord {
  id            String   @id @default(uuid())
  key           String   @unique
  requestHash   String   @map("request_hash")
  applicationId String   @map("application_id")
  responseData  Json     @map("response_data")
  createdAt     DateTime @default(now()) @map("created_at")
  expiresAt     DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("idempotency_records")
}
