# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/suretyseven?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# External APIs
APPLICANT_API_URL=http://localhost:3000/external/applicants
APPLICANT_API_TIMEOUT_MS=5000
APPLICANT_API_MAX_RETRIES=3

DOWNSTREAM_API_URL=http://localhost:3000/external/downstream/events
DOWNSTREAM_API_TIMEOUT_MS=5000
DOWNSTREAM_API_MAX_RETRIES=5

# Queue Configuration
QUEUE_EVALUATION_CONCURRENCY=5
QUEUE_NOTIFICATION_CONCURRENCY=3

# Security
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
